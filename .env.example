# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PORTAL_PORT=6502
EXCEL_DIR=.
# Login dan alokasi petugas aktif secara default.
AUTH_REQUIRED=1
# Set to 1 only when served over HTTPS. Local HTTP requires 0.
COOKIE_SECURE=0
# Set to 1 only behind your trusted reverse proxy; direct access must be restricted.
TRUST_PROXY=0
# Optional Traefik override
PORTAL_HOST=portal.example.org
TRAEFIK_NETWORK=traefik
TRAEFIK_RESOLVER=letsencrypt
